# Dashcall web app (login + single-page app + proxy to the agent).
# Copy to web/.env; `docker compose up` (in web/) and `npm run web` (in the repo root) load it.
# Every variable is documented in docs/CONFIGURATION.md.

# ---- Required ---------------------------------------------------------------------------------------------------
# Login password. Anyone who knows it can run commands on your Mac: make it long and random.
DASHCALL_PASSWORD=
# Key for signing session cookies. Generate: openssl rand -hex 32
DASHCALL_SECRET=
# Where the agent listens, e.g. http://100.x.y.z:7420 (the Mac's Tailscale IP). A trailing slash is ignored.
DASHCALL_AGENT_URL=
# Must equal DASHCALL_TOKEN in the agent's .env.
DASHCALL_AGENT_TOKEN=

# ---- Optional ---------------------------------------------------------------------------------------------------
# Port to listen on. docker-compose.yml publishes the same port on 127.0.0.1 only; point your reverse proxy at it.
PORT=8080
# Address to listen on (default 127.0.0.1, this machine only). The Docker image already sets 0.0.0.0; leave it unset.
# HOST=127.0.0.1
# 1 = trust the X-Forwarded-For header from your reverse proxy (Caddy, nginx) so the login rate limit sees real
# client IPs. Leave unset when clients connect directly: the header would then be client-controlled.
# docker-compose.yml already sets this to 1.
# DASHCALL_TRUST_PROXY=1
# 0 = allow the session cookie over plain http. Only for local development; login fails over http otherwise.
# DASHCALL_COOKIE_SECURE=0
