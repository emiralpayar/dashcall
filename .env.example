# Dashcall agent (runs on the Mac with herdr + Claude Code).
# Copy to .env and fill in; `npm run agent` loads it. Every variable is documented in docs/CONFIGURATION.md.
# Empty values count as unset. Relative paths are relative to the repo root.

# ---- Required ---------------------------------------------------------------------------------------------------
# Shared secret between the web app and the agent (must equal DASHCALL_AGENT_TOKEN in web/.env).
# Generate: openssl rand -hex 32
DASHCALL_TOKEN=

# ---- Network ----------------------------------------------------------------------------------------------------
# Address to listen on. 127.0.0.1 is only reachable from this Mac; set your Tailscale IP (`tailscale ip -4`)
# so the web server can reach it. Never expose the agent to the public internet.
DASHCALL_BIND=127.0.0.1
DASHCALL_PORT=7420

# ---- Language ---------------------------------------------------------------------------------------------------
# Used when a request doesn't say which language the user speaks: en or tr. The app sends its own choice.
DASHCALL_DEFAULT_LANGUAGE=en
# Voices for the local macOS `say` fallback, per language (list them with: say -v '?').
# DASHCALL_SAY_VOICE_EN=Samantha
# DASHCALL_SAY_VOICE_TR=Yelda
# Time zone the dispatcher uses for "now" (defaults to the system zone).
# TZ=Europe/Istanbul

# ---- Sessions ---------------------------------------------------------------------------------------------------
# Command typed into a new herdr pane to start a Claude Code session. Plain `claude` asks for permissions, so
# unattended background tasks stop at the first prompt. `claude --dangerously-skip-permissions` avoids that;
# understand the risk first (see SECURITY.md).
DASHCALL_SESSION_COMMAND=claude
# New sessions may only be started in folders under this directory (default: your home directory).
# DASHCALL_WORKSPACE_ROOT=/Users/you/code

# ---- Dispatcher -------------------------------------------------------------------------------------------------
# Claude model for the dispatcher (headless `claude -p --model ...`).
DASHCALL_DISPATCH_MODEL=sonnet
# The dispatcher may only run the `dashcall` CLI. UNSAFE: 1 brings back --dangerously-skip-permissions (every tool,
# no checks). Only for debugging; see docs/ARCHITECTURE.md ("The dispatcher's permissions").
# DASHCALL_DISPATCH_UNRESTRICTED=1

# ---- Speech -----------------------------------------------------------------------------------------------------
# whisper.cpp model file (download with ./scripts/download-model.sh).
# DASHCALL_WHISPER_MODEL=models/ggml-large-v3-turbo-q5_0.bin
# Silero voice-activity model (the same script downloads it). Only detected speech reaches whisper, so silence and
# noise don't come back as made-up text. Without the file, speech-to-text still works (the log says so once).
# `off` turns it off.
# DASHCALL_WHISPER_VAD_MODEL=models/ggml-silero-v6.2.0.bin

# ---- Binaries (only if they are not on PATH) ----------------------------------------------------------------------
# DASHCALL_CLAUDE_BIN=claude
# DASHCALL_HERDR_BIN=herdr
# DASHCALL_FFMPEG_BIN=ffmpeg
# DASHCALL_WHISPER_BIN=whisper-cli
# Python with edge-tts installed; without it the agent falls back to macOS `say`.
# DASHCALL_TTS_PYTHON=tts/.venv/bin/python

# ---- Data & logging -----------------------------------------------------------------------------------------------
# Where runtime data lives (defaults shown; both are git-ignored and private).
# DASHCALL_BRAIN_FILE=dispatcher/brain/brain.json
# DASHCALL_STATE_DIR=state
# Log transcripts and questions to stdout (off by default: they are private).
# DASHCALL_LOG_CONTENT=1
